{
  "name": "milliy-kutubxona-frontend",
  "private": true,
  "version": "1.0.0",
  "productName": "Milliy Kutubxona Ekran",
  "description": "O'zbekiston Milliy kutubxonasi — infokiosk va zal ekrani",
  "author": "O'zbekiston Milliy kutubxonasi",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build:electron": "vite build --mode electron && node tools/write-config-template.mjs",
    "electron:dev": "node tools/electron-dev.mjs",
    "electron:start": "npm run build:electron && node tools/electron-run.mjs",
    "electron:pack": "npm run build:electron && SKIP_RENDERER_BUILD=1 electron-builder --dir",
    "electron:build:win": "npm run build:electron && SKIP_RENDERER_BUILD=1 electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
